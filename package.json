{
  "name": "@thetanuts-finance/agentkit",
  "version": "0.1.1",
  "description": "Coinbase AgentKit ActionProvider for trading Thetanuts options on Base — for autonomous backend agents that own their own wallet (CDP, viem, Privy, server wallets).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo \"no tests yet\" && exit 0",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "thetanuts",
    "coinbase-agentkit",
    "agentkit",
    "ai-agent",
    "options",
    "defi",
    "base",
    "ethereum",
    "rfq"
  ],
  "author": "Thetanuts Finance",
  "license": "MIT",
  "homepage": "https://github.com/Thetanuts-Finance/thetanuts-agentkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thetanuts-Finance/thetanuts-agentkit.git"
  },
  "bugs": {
    "url": "https://github.com/Thetanuts-Finance/thetanuts-agentkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.5.0",
    "@thetanuts-finance/thetanuts-client": ">=0.2.5"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.5.0",
    "@thetanuts-finance/thetanuts-client": "file:../thetanuts-sdk",
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
